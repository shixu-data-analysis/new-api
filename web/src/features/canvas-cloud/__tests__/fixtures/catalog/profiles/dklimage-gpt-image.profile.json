{
  "schemaVersion": 1,
  "templateLanguageVersion": 1,
  "id": "dklimage.gpt-image",
  "version": "1.2.1",
  "kind": "image.generate",
  "displayName": "DKL-image GPT Image",
  "description": "同步图片生成；参考图使用 multipart/form-data 上传",
  "api": "dklimage-image@1.2.1",
  "workflow": "async",
  "securityScheme": "bearerAuth",
  "operations": {
    "submit": "generateDklImage",
    "submitWithImages": "editDklImage",
    "poll": "queryDklImageTask"
  },
  "advanced": {
    "media": {
      "image": {
        "delivery": "multipart-file"
      }
    },
    "request": {
      "parameterPolicy": {
        "baseUrlMode": "origin",
        "rawDefaults": {
          "response_format": "url",
          "async": true
        },
        "sizeParam": "size",
        "qualityParam": "quality",
        "countParam": "n"
      },
      "maxMultipartBytes": 67108864,
      "body": {
        "$merge": [
          {
            "$ref": "request.rawParams"
          },
          {
            "model": {
              "$ref": "model.upstreamId"
            },
            "prompt": {
              "$ref": "request.prompt"
            }
          }
        ]
      },
      "bodyWithImages": {
        "$merge": [
          {
            "$ref": "request.rawParams"
          },
          {
            "model": {
              "$ref": "model.upstreamId"
            },
            "prompt": {
              "$ref": "request.prompt"
            },
            "image[]": {
              "$map": {
                "from": {
                  "$ref": "media.images"
                },
                "as": "item",
                "template": {
                  "$ref": "item.file"
                }
              }
            }
          }
        ]
      }
    },
    "response": {
      "outputPaths": ["result.data[].url", "result.data[].b64_json"],
      "errorPaths": ["error.message", "message"]
    }
  },
  "map": {
    "submitResponse": {
      "taskId": ["/task_id"],
      "status": ["/status"]
    },
    "response": {
      "taskId": ["/task_id"],
      "status": ["/status"]
    }
  },
  "states": {
    "pending": ["queued", "pending"],
    "running": ["running", "processing", "in_progress"],
    "succeeded": ["succeeded"],
    "failed": ["failed", "canceled"]
  }
}
