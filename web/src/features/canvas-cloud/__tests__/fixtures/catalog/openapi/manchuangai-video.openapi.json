{
  "openapi": "3.1.0",
  "info": {
    "title": "ManChuang AI Video API",
    "version": "1.0.2"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos": {
      "post": {
        "operationId": "createManchuangaiVideoTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoTask"
                }
              }
            }
          }
        }
      }
    },
    "/v1/videos/{id}": {
      "get": {
        "operationId": "queryManchuangaiVideoTask",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoTask"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "VideoRequest": {
        "type": "object",
        "required": ["model", "prompt", "metadata"],
        "properties": {
          "model": {
            "type": "string"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "metadata": {
            "type": "object",
            "required": ["duration", "ratio"],
            "properties": {
              "duration": {
                "type": "integer",
                "minimum": 4,
                "maximum": 30
              },
              "ratio": {
                "type": "string",
                "enum": ["16:9", "9:16", "4:3", "3:4", "1:1"]
              },
              "resolution": {
                "type": "string",
                "enum": ["480p", "720p"]
              },
              "referenceImages": {
                "type": "array",
                "maxItems": 9,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "referenceVideos": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "referenceAudios": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "VideoTask": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "object": {
            "type": ["string", "null"]
          },
          "model": {
            "type": ["string", "null"]
          },
          "status": {
            "type": "string"
          },
          "progress": {
            "type": ["number", "null"]
          },
          "created_at": {
            "type": ["number", "null"]
          },
          "completed_at": {
            "type": ["number", "null"]
          },
          "metadata": {
            "type": ["object", "null"],
            "properties": {
              "url": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "error": {
            "type": ["object", "null"],
            "properties": {
              "message": {
                "type": ["string", "null"]
              },
              "code": {
                "type": ["string", "null"]
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  }
}
