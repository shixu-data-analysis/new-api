{
  "openapi": "3.1.0",
  "info": {
    "title": "HFSY Video API",
    "version": "2.0.6"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/video/create": {
      "post": {
        "operationId": "createHfsyVideoTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Video task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoSubmitResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/video/query/{id}": {
      "get": {
        "operationId": "queryHfsyVideoTask",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Video task status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoQueryResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "VideoCreateRequest": {
        "type": "object",
        "required": [
          "model",
          "orientation",
          "prompt",
          "duration"
        ],
        "properties": {
          "model": {
            "type": "string"
          },
          "orientation": {
            "type": "string",
            "enum": [
              "landscape",
              "portrait"
            ]
          },
          "ratio": {
            "type": "string",
            "enum": [
              "9:16",
              "3:4",
              "1:1",
              "4:3",
              "16:9",
              "21:9"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "duration": {
            "type": "integer",
            "minimum": 4,
            "maximum": 30
          },
          "images": {
            "type": "array",
            "maxItems": 30,
            "description": "Reference image URLs. Where required by the selected model, the combined image payload must not exceed 30 MB; individual images of at most 20 MB are recommended.",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "videos": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "audios": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "watermark": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      },
      "VideoSubmitResponse": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "VideoQueryResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "video_url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "fail_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  }
}
