{
  "version": 1,
  "context": {
    "model": { "upstreamId": "model-1", "protocolOptions": {} },
    "request": { "prompt": " Hello ", "aspectRatio": "9:16", "batchSize": 2, "outputIndex": 1, "background": "transparent", "rawParams": { "items": [1, 2] } },
    "media": { "images": [{ "role": "first_frame", "url": "https://example.test/first.png" }, { "role": "last_frame", "url": "https://example.test/last.png" }, { "role": "reference_image", "url": "https://example.test/ref-1.png" }, { "role": "reference_image", "url": "https://example.test/ref-2.png" }], "videos": [], "audios": [] }
  },
  "cases": [
    { "name": "reference", "template": { "$ref": "request.prompt" }, "output": " Hello " },
    { "name": "background-reference-only", "template": { "$ref": "request.background" }, "output": "transparent" },
    { "name": "fanout-output-index", "template": { "$ref": "request.outputIndex" }, "output": 1 },
    { "name": "missing-reference", "template": { "$ref": "request.negativePrompt" }, "undefined": true },
    { "name": "default", "template": { "$default": [{ "$ref": "request.negativePrompt" }, "fallback"] }, "output": "fallback" },
    { "name": "if", "template": { "$if": { "$ref": "request.batchSize" }, "then": "yes", "else": "no" }, "output": "yes" },
    { "name": "map-local", "template": { "$map": { "from": { "$ref": "request.rawParams.items" }, "as": "entry", "template": { "$ref": "entry" } } }, "output": [1, 2] },
    { "name": "merge", "template": { "$merge": [{ "a": 1 }, { "b": 2 }] }, "output": { "a": 1, "b": 2 } },
    { "name": "omit-object-array", "template": { "a": { "$omit": true }, "b": [1, { "$omit": true }, 2] }, "output": { "b": [1, 2] } },
    { "name": "lowercase", "template": { "$call": "lowercase", "args": ["ABC"] }, "output": "abc" },
    { "name": "uppercase", "template": { "$call": "uppercase", "args": ["abc"] }, "output": "ABC" },
    { "name": "trim", "template": { "$call": "trim", "args": [{ "$ref": "request.prompt" }] }, "output": "Hello" },
    { "name": "number", "template": { "$call": "number", "args": ["1.5"] }, "output": 1.5 },
    { "name": "integer", "template": { "$call": "integer", "args": ["2"] }, "output": 2 },
    { "name": "boolean", "template": { "$call": "boolean", "args": ["false"] }, "output": false },
    { "name": "json", "template": { "$call": "json", "args": ["{\"a\":1}"] }, "output": { "a": 1 } },
    { "name": "join", "template": { "$call": "join", "args": [[1, 2], "-"] }, "output": "1-2" },
    { "name": "concat", "template": { "$call": "concat", "args": [[1], [2]] }, "output": [1, 2] },
    { "name": "coalesce", "template": { "$call": "coalesce", "args": [null, "", 0] }, "output": 0 },
    { "name": "omit-empty", "template": { "drop": { "$call": "omitEmpty", "args": [[]] }, "keep": 0 }, "output": { "keep": 0 } },
    { "name": "orientation", "template": { "$call": "orientationForRatio", "args": [{ "$ref": "request.aspectRatio" }] }, "output": "portrait" },
    { "name": "first-frame", "template": { "$call": "mediaUrlByRole", "args": [{ "$ref": "media.images" }, "first_frame"] }, "output": "https://example.test/first.png" },
    { "name": "missing-role", "template": { "$call": "mediaUrlByRole", "args": [{ "$ref": "media.images" }, "unknown"] }, "undefined": true },
    { "name": "reference-images", "template": { "$call": "mediaUrlsByRole", "args": [{ "$ref": "media.images" }, "reference_image"] }, "output": ["https://example.test/ref-1.png", "https://example.test/ref-2.png"] },
    { "name": "missing-role-list", "template": { "$call": "mediaUrlsByRole", "args": [{ "$ref": "media.images" }, "unknown"] }, "output": [] },
    { "name": "ambiguous-role", "template": { "$call": "mediaUrlByRole", "args": [{ "$ref": "media.images" }, "reference_image"] }, "error": { "phase": "EVALUATION", "reason": "MEDIA_ROLE_AMBIGUOUS", "field": "template" } },
    { "name": "invalid-media-array", "template": { "$call": "mediaUrlsByRole", "args": [{}, "first_frame"] }, "error": { "phase": "EVALUATION", "reason": "MEDIA_ARGUMENT_INVALID", "field": "template" } },
    { "name": "invalid-media-item", "template": { "$call": "mediaUrlsByRole", "args": [[{ "role": 3 }], "first_frame"] }, "error": { "phase": "EVALUATION", "reason": "MEDIA_ITEM_INVALID", "field": "template" } },
    { "name": "missing-url", "template": { "$call": "mediaUrlByRole", "args": [[{ "role": "first_frame" }], "first_frame"] }, "error": { "phase": "EVALUATION", "reason": "MEDIA_URL_INVALID", "field": "template" } },
    { "name": "map-nonarray", "template": { "$map": { "from": 1, "as": "entry", "template": { "$ref": "entry" } } }, "error": { "phase": "EVALUATION", "reason": "MAP_REQUIRES_ARRAY", "field": "template.$map.from" } },
    { "name": "merge-nonobject", "template": { "$merge": [1] }, "error": { "phase": "EVALUATION", "reason": "MERGE_REQUIRES_OBJECT", "field": "template.$merge[0]" } },
    { "name": "unknown-function", "template": { "$call": "secret", "args": [1] }, "error": { "phase": "VALIDATION", "reason": "UNSUPPORTED_FUNCTION", "field": "template" } },
    { "name": "unknown-reference", "template": { "$ref": "credential.secret" }, "error": { "phase": "VALIDATION", "reason": "UNSUPPORTED_REFERENCE", "field": "template" } },
    { "name": "unbound-map-item", "template": { "$ref": "item.url" }, "error": { "phase": "VALIDATION", "reason": "UNSUPPORTED_REFERENCE", "field": "template" } },
    { "name": "unknown-companion", "template": { "$ref": "request.prompt", "args": [] }, "error": { "phase": "VALIDATION", "reason": "EXPRESSION_INVALID", "field": "template" } },
    { "name": "strict-json", "template": { "$call": "json", "args": ["{\"a\":1,\"a\":2}"] }, "error": { "phase": "EVALUATION", "reason": "JSON_CONVERSION_FAILED", "field": "template" } }
  ]
}
