# The dev server runs on Bun (the image has no Node). Bun 1.3.11 never sends the WebSocket handshake of a
# node:http upgrade, so HMR stays disconnected and lazily compiled imports never resolve; 1.4.2 sends it.
FROM oven/bun:1.4.2@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895

WORKDIR /app

COPY package.json bun.lock ./
COPY vendor ./vendor
RUN bun install --frozen-lockfile

COPY . .

CMD ["bun", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
